# Copy to server/.env and adjust.

# PostgreSQL connection. Leave empty to use the embedded PGlite database in ./data/pglite (development only).
# DATABASE_URL=postgres://its_pos:password@localhost:5432/its_pos

# REQUIRED in production: long random string used to sign sessions, PIN hashes and receipt links.
# Changing it invalidates all sessions, device registrations and employee PINs.
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Create the demo business (owner@demo.com / demo123) on first start. Set to false in production.
SEED_DEMO=true
