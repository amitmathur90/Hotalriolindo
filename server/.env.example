# Copy to server/.env and adjust.

# PostgreSQL connection. Leave empty to use the embedded PGlite database in ./data/pglite (development only).
# DATABASE_URL=postgres://its_pos:password@localhost:5432/its_pos

# REQUIRED in production: long random string used to sign sessions, PIN hashes and receipt links.
# Changing it invalidates all sessions, device registrations and employee PINs.
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Create the demo business (owner@demo.com / demo123) on first start. Set to false in production.
SEED_DEMO=true

# Changing JWT_SECRET also makes the stored Hacienda password and llave criptográfica unreadable (upload them again).

# Single hotel (default). Set to true to run as a multi-business SaaS with public sign-up and a platform admin.
# MULTI_TENANT=false

# --- Costa Rica electronic invoicing (Hacienda) ---
# Credentials, the .p12 key and the emisor data are entered in Back Office → Hacienda → Configuración.
# E-mail for sending facturas to customers (XML + Hacienda response). Without SMTP, facturas are not e-mailed.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=facturacion@example.com
# SMTP_PASS=app-password
# SMTP_FROM="Hotel Rio Lindo <facturacion@example.com>"
# Public URL used for the "view receipt" link in those e-mails (Render sets RENDER_EXTERNAL_URL automatically).
# APP_URL=https://pos.example.com
